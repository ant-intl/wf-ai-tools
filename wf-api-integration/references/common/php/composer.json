{
    "name": "worldfirst/wf-api-integration",
    "description": "WorldFirst API integration templates",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "{baseNamespace}\\Wf\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "{baseNamespace}\\Wf\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
